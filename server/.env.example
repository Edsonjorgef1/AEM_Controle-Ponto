# Porta da API
PORT=3000

# Ligação ao PostgreSQL — usar DATABASE_URL ou os campos individuais
DATABASE_URL=postgresql://ponto:ponto@localhost:5432/controle_ponto
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=controle_ponto
# PGUSER=ponto
# PGPASSWORD=ponto
# Ligações a servidores geridos (Neon, Render, RDS...) exigem SSL:
# PGSSL=true

# Segredo usado para assinar os tokens JWT do login. OBRIGATÓRIO em produção.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=12h

# Origens autorizadas do frontend (separadas por vírgula)
CORS_ORIGIN=http://localhost:8100,http://localhost:4200

# Administrador criado pelo `npm run seed`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@aem.local
ADMIN_PASSWORD=admin123
